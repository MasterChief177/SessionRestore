{
  "manifest_version": 3,
  "name": "SessionRestore",
  "short_name": "SessionRestore",
  "version": "0.1.0",
  "description": "Keeps a running history of your open tabs so you can get them back after a crash. Export any snapshot as Markdown.",
  "minimum_chrome_version": "110",
  "incognito": "not_allowed",
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "SessionRestore",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
